# ── Resqio configuration ─────────────────────────────────────────────
# Copy to .env and fill in. Everything has a safe default for demo mode.

# AWS / Amazon Bedrock (model reasoning)
AWS_REGION=us-east-1
# Any Bedrock model id with tool-use support works; Claude models recommended.
# Use an inference-profile id (global./us./eu. prefix), not a bare foundation-model id.
BEDROCK_MODEL_ID=global.anthropic.claude-sonnet-4-6

# NOAA / NWS polling (api.weather.gov requires "(app-name, contact-email)" User-Agent)
NOAA_AREA=TX
NOAA_USER_AGENT=(resqio-community-disaster-agent, contact@example.com)
POLL_INTERVAL_SECONDS=300

# Twilio (WhatsApp/SMS approval pings)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# WhatsApp sandbox sender is whatsapp:+14155238886 unless you have a WA-enabled number
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_SMS_FROM=
# Comma-separated volunteer captain numbers, e.g. whatsapp:+15551234567,+15557654321
RESQIO_CAPTAIN_NUMBERS=

# Demo mode: 1 = simulated grid feed + console dispatcher (no Twilio/live outage feed needed)
RESQIO_DEMO_MODE=1

# Unanswered approval pings expire after this many minutes (frees both sides for re-matching)
RESQIO_MATCH_TTL_MINUTES=45
