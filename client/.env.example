# Resqio web client (Next.js) - deployment settings.
# Set these in your host's environment (e.g. Vercel → Project Settings →
# Environment Variables). Rewrites are resolved at BUILD time, so redeploy
# after changing RESQIO_API_ORIGIN.

# Where the Resqio runtime (python -m src.integrations.webhook_server) is
# reachable. The browser only talks to this site; /status, /cycle, /demo/*,
# and /sms are proxied server-side to this origin.
# Local development default: http://127.0.0.1:5001
RESQIO_API_ORIGIN=https://resqio.38.49.216.120.sslip.io

# Optional: have the browser call a runtime directly instead of using the
# proxy (that runtime must then allow CORS from this site).
#NEXT_PUBLIC_RESQIO_API=
